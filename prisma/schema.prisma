generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // Use SQLite for simplicity
}
model Category {
  id       Int     @id @default(autoincrement())
  name     String
  quizzes  Quiz[]  @relation("CategoryQuizzes")
}

model Quiz {
  id        Int        @id @default(autoincrement())
  question  String
  options   String
  answer    String
  questions Question[] @relation("QuizQuestions")
  categoryId Int?     // This is the foreign key
  category  Category? @relation("CategoryQuizzes", fields: [categoryId], references: [id]) // Relationship to Category
}

model Question {
  id     Int    @id @default(autoincrement())
  text   String
  quizId Int
  quiz   Quiz   @relation("QuizQuestions", fields: [quizId], references: [id])
}